# API base URL (local stack: http://localhost:4000/api/v1)
VITE_API_URL=http://localhost:4000/api/v1
# "simulate" shows a fake-payment UI; use "live" with the mock DTB locally
VITE_PAYMENT_MODE=live
# Error tracking (optional)
VITE_SENTRY_DSN=
VITE_APP_ENV=local

# Feature switches. Each is OFF unless exactly "true".
# Feedback + pre-register forms really submit to the API
VITE_FORMS_ENABLED=false
# /login and /account
VITE_ACCOUNT_ENABLED=false
# /register flow (also needs the date to be past 10 Feb 2027)
VITE_REGISTRATION_ENABLED=false
# Raffle ticket purchase
VITE_RAFFLE_ENABLED=false
# /donate
VITE_DONATE_ENABLED=false
